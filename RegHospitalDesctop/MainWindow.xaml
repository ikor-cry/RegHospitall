<Window x:Class="RegHospitalDesctop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RegHospitalDesctop"
        mc:Ignorable="d"
        Title="MainWindow" Height="650" Width="1000">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="100"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="FontSize" Value="20"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Height="50">
            <TextBox Text="Шапка" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Left" Width="150">
            <TextBox Text="Объекты" Height="40"/>
            <Button Content="Главная" Click="Main_Click" Margin="5"/>
            <Button Content="Доктора" Click="Doctor_Click" Margin="5"/>
            <Button Content="Пациент" Click="Patient_Click" Margin="5"/>
            <Button Content="Комнаты" Click="Room_Click" Margin="5"/>


        </StackPanel>
        <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden" Background="Beige" />
    </DockPanel>
</Window>
