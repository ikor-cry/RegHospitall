<Page x:Class="RegHospitalDesctop.Pages.AppointmentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RegHospitalDesctop.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="550" d:DesignWidth="800"
      Title="AppointmentPage">

    <Page.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Width" Value="150"/>
            <Setter Property="Margin" Value="15"/>
        </Style>
    </Page.Resources>

    <StackPanel>
        <TextBlock Text="Посещение" FontSize="20" Margin="10"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сортировка ⬆️" Click="SortUpButton_Click"/>
            <Button Content="Сортировка ⬇️" Click="SortDownButton_Click"/>
            <ComboBox x:Name="FilterSpec" 
                   DisplayMemberPath="Name" 
                   SelectedValuePath="Id" 
                   Width="130" 
                   
                   SelectionChanged="FilterSpec_SelectionChanged"/>
            <TextBox x:Name="txtSearch" Width="200" TextChanged="txtCerarh_TextChanged"/>
        </StackPanel>
        <DataGrid x:Name="tableAppointment" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="tableAppointment_SelectionChanged"  Height="250">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Пациент" Binding="{Binding Patient.FullName}"/>
                <DataGridTextColumn Header="Доктор" Binding="{Binding Doctor.FullName}"/>
                <DataGridTextColumn Header="Дата Приёма" Binding="{Binding AppointmentDate, StringFormat=dd.MM.yyyy}"/>
                <DataGridTextColumn Header="Время приёма" Binding="{Binding AppointmentTime, StringFormat='HH:mm'}"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Orientation="Horizontal" Margin="10">
            <ComboBox  x:Name="PatientList"
                    DisplayMemberPath="FullName" 
                    SelectedValuePath="PatientId" 
                    SelectedValue="{Binding PatientId}"
         
                    Height="20" 
                    Width="150" 
                    Margin="10" SelectionChanged="SpecList_SelectionChanged_1"/>
            <ComboBox  x:Name="DoctorList"
                    DisplayMemberPath="FullName" 
                    SelectedValuePath="DoctorId" 
                    SelectedValue="{Binding DoctorId}" 
                    Height="20"
                    
                    Width="150" 
                    Margin="10" SelectionChanged="RoomsList_SelectionChanged"/>
            <TextBox Text="{Binding AppointmentDate, StringFormat='dd.MM.yyyy'}" Height="20" Width="150" Background="Azure" Margin="10" TextChanged="TextBox_TextChanged"/>
            <TextBox Text="{Binding AppointmentTime, StringFormat='HH:mm', UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" Height="20" Width="200" Background="Azure" Margin="10" TextChanged="TextBox_TextChanged"/>
        </StackPanel>


        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Сохранить изменения" Click="btnclick"/>
            <Button Content="Добавить" Click="Button_Click"/>
            <Button Content="Удалить" Click="ButtonDel_Click"/>
        </StackPanel>




    </StackPanel>

</Page>
