<Page x:Class="RegHospitalDesctop.Pages.DoctorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RegHospitalDesctop.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="DoctorPage">
    <Page.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Width" Value="150"/>
            <Setter Property="Margin" Value="15"/>
        </Style>
    </Page.Resources>

    <StackPanel>
        <TextBlock Text="Доктора" FontSize="20" Margin="10"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Сортировка ⬆️" Click="Button_Click_1"/>
        <Button Content="Сортировка ⬇️" Click="Button_CLick_2"/>
            <ComboBox x:Name="FilterSpec" 
                      DisplayMemberPath="Name" 
                      SelectedValuePath="Id" 
                      Width="130" 
                      
                      SelectionChanged="FilterSpec_SelectionChanged"/>
            <TextBox x:Name="txtSearch" Width="200" TextChanged="txtSearch_TextChanged"/>
        </StackPanel>
        <DataGrid x:Name="tableDoctor" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="tableDoctor_SelectionChanged" Height="250">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}"/>
                <DataGridTextColumn Header="специальность" Binding="{Binding Specialtie.Name}"/>
                <DataGridTextColumn Header="кабинет" Binding="{Binding Room.Number}"/>
            </DataGrid.Columns>
        </DataGrid>
            
        <StackPanel Orientation="Horizontal" Margin="10">
            <TextBox Text="{Binding FullName}" Height="20" Width="200" Background="Azure" Margin="10"/>
            <ComboBox  x:Name="SpecList"
                       DisplayMemberPath="Name" 
                       SelectedValuePath="SpecialtieId" 
                       SelectedValue="{Binding SpecialtieId}"
            
                       Height="20" 
                       Width="150" 
                       Margin="10"/>
            <ComboBox  x:Name="RoomsList"
                       DisplayMemberPath="Number" 
                       SelectedValuePath="RoomId" 
                       SelectedValue="{Binding RoomId}" 
                       Height="20"
                       
                       Width="150" 
                       Margin="10"/>
            <TextBox Text="{Binding WorkShedule}" Height="20" Width="150" Background="Azure" Margin="10"/>
        </StackPanel>


        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Сохранить изменения" Click="btnclick"/>
            <Button Content="Добавить" Click="Button_Click"/>
            <Button Content="Удалить" Click="ButtonDel_Click"/>
        </StackPanel>
        
      


    </StackPanel>
        

</Page>
