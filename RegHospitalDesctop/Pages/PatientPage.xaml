<Page x:Class="RegHospitalDesctop.Pages.PatientPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RegHospitalDesctop.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PatientPage">

    <StackPanel>
        <TextBlock Text="Пациенты" FontSize="20"/>
        <DataGrid x:Name="tablePatient" SelectionChanged="Patientlist" Height="300"/>
        <StackPanel x:Name="StackPanel">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBox Text="{Binding FullName}" Height="20" Width="200" Background="Azure" Margin="10"/>
                <TextBox Text="{Binding BirthDate}" Height="20" Width="200" Background="Azure" Margin="10"/>
                <TextBox Text="{Binding Gender}" Height="20" Width="200" Background="Azure" Margin="10"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBox Text="{Binding Phone}" Height="20" Width="200" Background="Azure" Margin="10"/>
                <TextBox Text="{Binding Address}" Height="20" Width="200" Background="Azure" Margin="10"/>
                <TextBox Text="{Binding PolicyNumber}" Height="20" Width="200" Background="Azure" Margin="10"/>
            </StackPanel>
        </StackPanel>

        <Button Content="Сохранить изменнеия" Click="Button_Click"/>
        <Button Content="Удалить" Click="Del_Click"/>
        <Button Content="Добавить" Click="Dob_Click"/>

    </StackPanel>
</Page>
