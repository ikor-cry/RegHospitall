<Window x:Class="RegHospitalDesctop.Windows.AddAppWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RegHospitalDesctop.Windows"
        mc:Ignorable="d"
        Title="AddAppWindow" Height="450" Width="800">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Width" Value="160"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Width" Value="160"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Width" Value="160"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
    </Window.Resources>
    <StackPanel>
        <Label Content="Записатся на приём" FontSize="22" FontWeight="Bold" Margin="10"/>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Пациент:"/>
            <ComboBox x:Name="PatientList"
                      DisplayMemberPath="FullName"
                      SelectedValuePath="PatientId"
                      SelectedValue="{Binding PatientId}"
                      Width="350"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Доктор:"/>
            <ComboBox x:Name="DoctorList"
                      DisplayMemberPath="FullName"
                      SelectedValuePath="DoctorId"
                      SelectedValue="{Binding DoctorId}"
                      Width="350"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Дата приёма:"/>
            <TextBox Text="{Binding AppointmentDate, StringFormat=dd.MM.yyyy}"/>
            <TextBlock Text="Тип визита:"/>
            <TextBox Text="{Binding VisitType}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Время приёма:"/>
            <TextBox Text="{Binding AppointmentTime, StringFormat='HH:mm'}" />
            <TextBlock Text="Статус"/>
            <ComboBox x:Name="StatusList"
          SelectedValue="{Binding Status}"
          IsEditable="True"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,80">
            <Button Content="Сохранить" Height="35" Width="130" Click="Button_Click" Margin="10"/>
            <Button Content="Отмена" Height="35" Width="130" Click="Button_Click_1" Margin="10"/>
        </StackPanel>
    </StackPanel>
</Window>
