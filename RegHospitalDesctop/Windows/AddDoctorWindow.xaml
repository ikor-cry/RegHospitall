<Window x:Class="RegHospitalDesctop.Windows.AddDoctorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RegHospitalDesctop.Windows"
        mc:Ignorable="d"
        Title="AddDoctorWindow" Height="250" Width="500">
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Margin" Value="6"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="18"/>
        </Style>
    </Window.Resources>
    
    <StackPanel>
        <StackPanel Orientation="Horizontal">
            <Label Content="ФИО:"/>
            <TextBox Text="{Binding FullName}"/>
            <Label Content="Комната фйди:"/>

            <ComboBox x:Name="listRoom" 
              IsEditable="True"
              IsTextSearchEnabled="True"
              DisplayMemberPath="Number"
              SelectedValuePath="RoomId"
              SelectedValue="{Binding RoomId}"
              Height="20" MaxWidth="100" Width="100"/>  

        </StackPanel>
        <StackPanel Orientation="Horizontal">
            <Label Content="айди Специальность:"/>
            
            <ComboBox x:Name="listSpecs" 
                      IsEditable="True"
                      IsTextSearchEnabled="True"
                      DisplayMemberPath="Name"
                      SelectedValuePath="SpecialtieId"
                      SelectedValue="{Binding SpecialtieId}"
                      Height="20" MaxWidth="100" Width="100"/>


            <Label Content="Рассисание:"/>
            <TextBox Text="{Binding WorkShedule}"/>
        </StackPanel>
        <StackPanel>
            <Button Content="Сохранить" Click="Button_Click"/>
            <Button Content="Отмена" Click="Cancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
