<Window x:Class="RegHospitalDesctop.Windows.AddPatientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RegHospitalDesctop.Windows"
        mc:Ignorable="d"
        Title="AddPatientWindow" Height="450" Width="800">
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Margin" Value="6"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="18"/>
        </Style>
    </Window.Resources>

    <StackPanel>
        <StackPanel Orientation="Horizontal">
            <Label Content="ФИО:"/>
            <TextBox Text="{Binding FullName}"/>
            
            <Label Content="Дата:"/>
            <TextBox Text="{Binding BirthDate}"/>
            <Label Content="Пол:"/>
            <TextBox Text="{Binding Gender}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
            <Label Content="Телефон:"/>
            <TextBox Text="{Binding Phone}"/>
            <Label Content="Адрес:"/>
            <TextBox Text="{Binding Address}"/>
            <Label Content="Полис:"/>
            <TextBox Text="{Binding PolicyNumber}"/>
        </StackPanel>
        
        <StackPanel>
            <Button Content="Сохранить" Click="Button_Click"/>
            <Button Content="Отмена" Click="Cancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>

