<Window x:Class="RegHospitalDesctop.Windows.AddRoomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RegHospitalDesctop.Windows"
        mc:Ignorable="d"
        Title="AddRoomWindow" Height="250" Width="300">
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Margin" Value="6"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Width" Value="125"/>
            <Setter Property="Height" Value="18"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Window.Resources>

    <StackPanel>
        <StackPanel >
            <StackPanel Orientation="Horizontal">
                <Label Content="Номер:"/>
                <TextBox Text="{Binding Number}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Label Content="Этаж:"/>
                <TextBox Text="{Binding Floor}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Label Content="Специальность врача:"/>
                <TextBox Text="{Binding Purpose}"/>
            </StackPanel>
        </StackPanel>


        <StackPanel Margin="0,30,0,0">
            <Button Content="Сохранить" Click="AddButton"/>
            <Button Content="Отмена" Click="Cancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
